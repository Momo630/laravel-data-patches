{
    "name": "momo630/laravel-data-patches",
    "type": "library",
    "description": "Explicit, recorded one-off data patches for Laravel applications.",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0 || ^13.8",
        "illuminate/database": "^12.0 || ^13.8",
        "illuminate/support": "^12.0 || ^13.8"
    },
    "require-dev": {
        "league/flysystem-aws-s3-v3": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Momo630\\LaravelDataPatches\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Momo630\\LaravelDataPatches\\LaravelDataPatchesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
